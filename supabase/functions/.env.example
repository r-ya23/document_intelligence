# Backend / Edge Function secrets — set via `supabase secrets set KEY=value`, never committed.
# These are read inside supabase/functions/* via Deno.env.get(...).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the Supabase runtime
# for Edge Functions (local and hosted) — you do NOT need to set them manually.

# Mistral AI — used by extract-and-structure for OCR (documents/images, via /v1/ocr with
# document_annotation_format) and for plain text files (via /v1/chat/completions), and by
# query-router's classify step (filter vs semantic). Free tier available. Get a key from
# console.mistral.ai/api-keys.
MISTRAL_API_KEY=...

# Embedding provider — Voyage AI voyage-3 (1024-dim, matches documents.embedding column)
EMBEDDING_API_KEY=pa-...
